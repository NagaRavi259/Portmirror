# Copy to .env and adjust. docker compose reads it automatically.

# Where the manager UI/API is published on the host. Default: loopback only.
# Use the Tailscale IP to reach it over your tailnet. Never the public IP.
# PM_UI_BIND=100.86.18.68

# Retention in days. 0 or unset = keep forever (default).
PM_HISTORY_RETENTION_DAYS=0     # traffic history (1-minute rollups behind the 24h/7d/30d/1y/all charts)
PM_AUDIT_RETENTION_DAYS=0       # audit log (who changed what)

# Optional fixed admin password instead of a generated one (first start only).
# PM_ADMIN_PASSWORD=

# Demo traffic generator (docker compose --profile traffic up -d traffic_gen).
# TRAFFIC_LEVEL scales everything (0 = idle, 2 = double). Per-second rates at level 1:
# TRAFFIC_LEVEL=1.0
# BULK_MBPS=20      # HTTP download throughput from A
# HTTP_RPS=25
# HTTPS_RPS=6
# UDP_STREAM_MBPS=4  # persistent UDP streams, each way
# UDP_STREAMS=4
# UDP_PPS=10        # one-shot UDP flows
# PG_QPS=3
# WS_HOLD=12        # long-lived WebSocket sessions
# VNC_HOLD=3        # long-lived VNC sessions
# RDP_HOLD=2
# CLIENTS=8         # simulated client IPs
