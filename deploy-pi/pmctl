#!/bin/sh
# Native (non-Docker) equivalent of the container's `pmctl` - installed by
# install.sh to /usr/local/bin/pmctl. See ../manager/app/cli.py for commands.
#
# internal.token is intentionally root-only (0600) - any other logged-in user
# on the Pi could otherwise read it and get full admin API access. So this
# wrapper re-execs itself under sudo when not already root, instead of
# crashing with a raw PermissionError traceback (a real one hit in testing).
if [ "$(id -u)" != "0" ]; then
  exec sudo -E "$0" "$@"
fi
export PM_STATE_DIR="${PM_STATE_DIR:-/var/lib/portmirror}"
export PM_UI_PORT="${PM_UI_PORT:-8088}"
cd /opt/portmirror && exec /opt/portmirror/venv/bin/python3 -m app.cli "$@"
