# /etc/portmirror/portmirror.env
# Read by both systemd units (portmirror-base.service, portmirror-manager.service)
# via EnvironmentFile=. Copy this to /etc/portmirror/portmirror.env and edit it -
# keep LAN_IF/VPN_IF/LAN_NET/VPN_NET in sync with the same values in nftables.conf.

# --- must match nftables.conf ---
PM_LAN_IF=eth0
PM_VPN_IF=wg0
PM_LAN_NET=192.168.1.0/24
PM_VPN_NET=10.0.0.0/24
# The gateway's own address on each side (used for validation messages and the
# UI; not used to assign addresses - your network config already does that).
PM_GW_LAN_IP=192.168.1.1
PM_GW_VPN_IP=10.0.0.2

# --- manager ---
PM_UI_PORT=8088
PM_STATE_DIR=/var/lib/portmirror
PM_UI_DIR=/opt/portmirror/ui
# Optional: a JSON file of forwards to create once, the first time the database
# is empty (see ../manager/seed.json for the shape). Leave unset for a real
# deployment - start with zero forwards and add your own through the UI.
# PM_SEED_FILE=/etc/portmirror/seed.json

# Retention in days for traffic history and the audit log. 0 / unset = forever.
PM_HISTORY_RETENTION_DAYS=0
PM_AUDIT_RETENTION_DAYS=0

# Optional: a fixed admin password instead of a random generated one. Only
# read on the very first start (when no admin account exists yet).
# PM_ADMIN_PASSWORD=
