# /etc/systemd/system/portmirror-base.service
#
# Loads the static nftables base ruleset (masquerade, forward filter, UI-port
# protection) once the VPN interface exists, then restores the dynamic
# forwards the manager last applied (/var/lib/portmirror/pm.nft) - so
# forwarding resumes on boot even before, or if, the manager itself starts.
#
# Replace wg-quick@wg0.service with your real VPN unit (openvpn-client@x, ...).
# BindsTo= re-runs this whenever the VPN unit restarts, so rules are never
# left pointing at a tunnel that was torn down and recreated.

[Unit]
Description=Port-mirroring gateway - base nftables ruleset
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
BindsTo=wg-quick@wg0.service
Before=portmirror-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/portmirror/portmirror.env
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do ip link show "$PM_VPN_IF" >/dev/null 2>&1 && ip link show "$PM_LAN_IF" >/dev/null 2>&1 && exit 0; sleep 1; done; echo "PM_LAN_IF/PM_VPN_IF never appeared" >&2; exit 1'
# per-connection byte counters: without this every session shows 0 bytes in the connection log
ExecStartPre=-/sbin/sysctl -w net.netfilter.nf_conntrack_acct=1
ExecStart=/usr/sbin/nft -f /etc/portmirror/nftables.conf
ExecStart=/bin/sh -c '[ -f "$PM_STATE_DIR/pm.nft" ] && /usr/sbin/nft -f "$PM_STATE_DIR/pm.nft" || true'
ExecStop=-/usr/sbin/nft delete table ip pm_nat
ExecStop=-/usr/sbin/nft delete table inet pm_filter
ExecStop=-/usr/sbin/nft delete table ip pm

[Install]
WantedBy=multi-user.target wg-quick@wg0.service
